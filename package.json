{
  "name": "pharmatory",
  "version": "1.0.0",
  "description": "Pharmatory application with Fastify, TypeScript, Tailwind CSS, DaisyUI, and Alpine.js",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "build:css": "tailwindcss -i src/styles/app.css -o public/css/styles.css --minify",
    "build:ts": "tsc",
    "build": "npm run build:css && npm run build:ts",
    "dev:css": "tailwindcss -i src/styles/app.css -o public/css/styles.css --watch",
    "dev:server": "tsx watch src/server.ts",
    "dev": "concurrently -n \"CSS,SERVER\" -c \"magenta,cyan\" \"npm run dev:css\" \"npm run dev:server\"",
    "start": "node dist/server.js",
    "test": "tsx --test tests/unit/fulfillment.test.ts tests/integration/api.test.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "keywords": [
    "fastify",
    "typescript",
    "tailwind",
    "daisyui",
    "alpinejs"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@fastify/multipart": "^10.1.6",
    "@fastify/static": "^10.1.7",
    "@fastify/swagger": "^9.9.2",
    "@scalar/fastify-api-reference": "^1.75.1",
    "@tailwindcss/cli": "^4.3.3",
    "alpinejs": "^3.17.5",
    "better-sqlite3": "^13.0.3",
    "daisyui": "^5.7.50",
    "fastify": "^5.12.7",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.5",
    "concurrently": "^10.0.6",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0"
  }
}
